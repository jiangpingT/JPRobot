<?xml version="1.0"?>
<!-- BittleX ESP32 URDF model for PyBullet simulation.
     Based on ger01d/opencat-gym bittle_esp32.urdf.

     Physical specs:
       - Body: 105mm x 80mm x 20mm, 111g
       - Battery: 90mm x 40mm x 15mm, 68g
       - Upper limb: r=3mm, l=45mm, 5g
       - Lower limb: r=3mm, l=50mm, 17g
       - 8 revolute joints (4 legs x 2 DOF)
-->
<robot name="BittleX">

    <material name="blue">
        <color rgba="0.2 0.4 0.9 1"/>
    </material>
    <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>
    <material name="yellow">
        <color rgba="1 0.7 0 1"/>
    </material>

    <!-- === TORSO === -->
    <link name="torso">
        <visual>
            <geometry><box size="0.105 0.08 0.02"/></geometry>
            <material name="yellow"/>
        </visual>
        <collision>
            <geometry><box size="0.105 0.08 0.02"/></geometry>
        </collision>
        <inertial>
            <mass value="0.111"/>
            <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <!-- === BATTERY === -->
    <link name="battery">
        <visual>
            <geometry><box size="0.09 0.04 0.015"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><box size="0.09 0.04 0.015"/></geometry>
        </collision>
        <inertial>
            <mass value="0.068"/>
            <inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="battery_joint" type="fixed">
        <origin xyz="0 0 -0.015" rpy="0 0 0"/>
        <parent link="torso"/>
        <child link="battery"/>
    </joint>

    <!-- === LEFT FRONT LEG === -->
    <link name="left_upper_arm">
        <visual>
            <origin xyz="0 0 -0.0225"/>
            <geometry><cylinder radius="0.003" length="0.045"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.0225"/>
            <geometry><cylinder radius="0.003" length="0.045"/></geometry>
        </collision>
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="left_lower_arm">
        <visual>
            <origin xyz="0 0 -0.025"/>
            <geometry><cylinder radius="0.003" length="0.05"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.025"/>
            <geometry><cylinder radius="0.003" length="0.05"/></geometry>
        </collision>
        <inertial>
            <mass value="0.017"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="left_front_paw">
        <visual>
            <origin rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.006" length="0.008"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.006" length="0.005"/></geometry>
        </collision>
        <contact>
            <friction_anchor/>
            <stiffness value="2000.0"/>
            <damping value="20.0"/>
            <spinning_friction value="0.3"/>
            <lateral_friction value="1"/>
        </contact>
        <inertial>
            <mass value="0.0005"/>
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="shoulder_left" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="0.055 0.05 0"/>
        <parent link="torso"/>
        <child link="left_upper_arm"/>
        <limit effort="0.2" lower="-1.57" upper="1.57" velocity="31.4"/>
    </joint>

    <joint name="elbow_left" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="0 -0.015 -0.045" rpy="0 -1.57 0"/>
        <parent link="left_upper_arm"/>
        <child link="left_lower_arm"/>
        <limit effort="0.2" lower="-1.57" upper="1.57" velocity="31.4"/>
    </joint>

    <joint name="paw_front_left" type="fixed">
        <origin xyz="0 0 -0.05" rpy="0 -1.57 0"/>
        <parent link="left_lower_arm"/>
        <child link="left_front_paw"/>
    </joint>

    <!-- === RIGHT FRONT LEG === -->
    <link name="right_upper_arm">
        <visual>
            <origin xyz="0 0 -0.0225"/>
            <geometry><cylinder radius="0.003" length="0.045"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.0225"/>
            <geometry><cylinder radius="0.003" length="0.045"/></geometry>
        </collision>
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="right_lower_arm">
        <visual>
            <origin xyz="0 0 -0.025"/>
            <geometry><cylinder radius="0.003" length="0.05"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.025"/>
            <geometry><cylinder radius="0.003" length="0.05"/></geometry>
        </collision>
        <inertial>
            <mass value="0.017"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="right_front_paw">
        <visual>
            <origin rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.006" length="0.008"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.006" length="0.005"/></geometry>
        </collision>
        <contact>
            <friction_anchor/>
            <stiffness value="2000.0"/>
            <damping value="20.0"/>
            <spinning_friction value="0.3"/>
            <lateral_friction value="1"/>
        </contact>
        <inertial>
            <mass value="0.0005"/>
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="shoulder_right" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="0.055 -0.05 0"/>
        <parent link="torso"/>
        <child link="right_upper_arm"/>
        <limit effort="0.2" lower="-1.57" upper="1.57" velocity="31.4"/>
    </joint>

    <joint name="elbow_right" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="0 0.015 -0.045" rpy="0 -1.57 0"/>
        <parent link="right_upper_arm"/>
        <child link="right_lower_arm"/>
        <limit effort="0.2" lower="-1.57" upper="1.57" velocity="31.4"/>
    </joint>

    <joint name="paw_front_right" type="fixed">
        <origin xyz="0 0 -0.05" rpy="0 -1.57 0"/>
        <parent link="right_lower_arm"/>
        <child link="right_front_paw"/>
    </joint>

    <!-- === RIGHT BACK LEG === -->
    <link name="right_upper_leg">
        <visual>
            <origin xyz="0 0 -0.0225"/>
            <geometry><cylinder radius="0.003" length="0.045"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.0225"/>
            <geometry><cylinder radius="0.003" length="0.045"/></geometry>
        </collision>
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="right_lower_leg">
        <visual>
            <origin xyz="0 0 -0.025"/>
            <geometry><cylinder radius="0.003" length="0.05"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.025"/>
            <geometry><cylinder radius="0.003" length="0.05"/></geometry>
        </collision>
        <inertial>
            <mass value="0.017"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="right_back_paw">
        <visual>
            <origin rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.006" length="0.008"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.006" length="0.005"/></geometry>
        </collision>
        <contact>
            <friction_anchor/>
            <stiffness value="2000.0"/>
            <damping value="20.0"/>
            <spinning_friction value="0.3"/>
            <lateral_friction value="1"/>
        </contact>
        <inertial>
            <mass value="0.0005"/>
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="hip_right" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="-0.055 -0.05 0"/>
        <parent link="torso"/>
        <child link="right_upper_leg"/>
        <limit effort="0.2" lower="-1.57" upper="2.0" velocity="31.4"/>
    </joint>

    <joint name="knee_right" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="0 0.015 -0.045" rpy="0 -1.57 0"/>
        <parent link="right_upper_leg"/>
        <child link="right_lower_leg"/>
        <limit effort="0.2" lower="-1.57" upper="1.57" velocity="31.4"/>
    </joint>

    <joint name="paw_back_right" type="fixed">
        <origin xyz="0 0 -0.05" rpy="0 -1.57 0"/>
        <parent link="right_lower_leg"/>
        <child link="right_back_paw"/>
    </joint>

    <!-- === LEFT BACK LEG === -->
    <link name="left_upper_leg">
        <visual>
            <origin xyz="0 0 -0.0225"/>
            <geometry><cylinder radius="0.003" length="0.045"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.0225"/>
            <geometry><cylinder radius="0.003" length="0.045"/></geometry>
        </collision>
        <inertial>
            <mass value="0.005"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="left_lower_leg">
        <visual>
            <origin xyz="0 0 -0.025"/>
            <geometry><cylinder radius="0.003" length="0.05"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.025"/>
            <geometry><cylinder radius="0.003" length="0.05"/></geometry>
        </collision>
        <inertial>
            <mass value="0.017"/>
            <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="left_back_paw">
        <visual>
            <origin rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.006" length="0.008"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin rpy="1.57 0 0"/>
            <geometry><cylinder radius="0.006" length="0.005"/></geometry>
        </collision>
        <contact>
            <friction_anchor/>
            <stiffness value="2000.0"/>
            <damping value="20.0"/>
            <spinning_friction value="0.3"/>
            <lateral_friction value="1"/>
        </contact>
        <inertial>
            <mass value="0.0005"/>
            <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <joint name="hip_left" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="-0.055 0.05 0"/>
        <parent link="torso"/>
        <child link="left_upper_leg"/>
        <limit effort="0.2" lower="-1.57" upper="2.0" velocity="31.4"/>
    </joint>

    <joint name="knee_left" type="revolute">
        <axis xyz="0 1 0"/>
        <origin xyz="0 -0.015 -0.045" rpy="0 -1.57 0"/>
        <parent link="left_upper_leg"/>
        <child link="left_lower_leg"/>
        <limit effort="0.2" lower="-1.57" upper="1.57" velocity="31.4"/>
    </joint>

    <joint name="paw_back_left" type="fixed">
        <origin xyz="0 0 -0.05" rpy="0 -1.57 0"/>
        <parent link="left_lower_leg"/>
        <child link="left_back_paw"/>
    </joint>

</robot>
